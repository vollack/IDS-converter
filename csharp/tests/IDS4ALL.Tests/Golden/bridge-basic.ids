<?xml version="1.0" encoding="utf-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <!-- Created with the IDS4ALL Converter test. -->
	<info>
        <title>Bridge test</title>
        <copyright>TU Wien</copyright>
        <version>1.0</version>
        <description>Bridge test file</description>
        <author>test@example.org</author>
        <date>2026-01-01</date>
        <purpose>Role: Architect</purpose>
        <milestone>P1, P2</milestone>
    </info>
    <specifications>
        <specification name="Walls" ifcVersion="IFC4 IFC4X3_ADD2" instructions="Phase: P1, P2; Role: Architect; Usecase: Permit">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                    <predefinedType>
                        <simpleValue>STANDARD</simpleValue>
                    </predefinedType>
                </entity>
            </applicability>
            <requirements>
                <entity instructions="Wall entity">
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
                <partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                        </name>
                    </entity>
                </partOf>
                <classification uri="https://example.org/c" cardinality="required">
                    <value>
                        <simpleValue>21.21</simpleValue>
                    </value>
                    <system>
                        <simpleValue>Uniclass</simpleValue>
                    </system>
                </classification>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <simpleValue>Wall 1</simpleValue>
                    </value>
                </attribute>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Description</simpleValue>
                    </name>
                </attribute>
                <property dataType="IFCLABEL" uri="https://example.org/p" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>FireRating</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="REI60" />
                            <xs:enumeration value="REI90" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCTHERMALTRANSMITTANCEMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ThermalTransmittance</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:maxInclusive value="0.5" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCREAL" cardinality="optional">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>LoadBearingCapacity</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="1.5" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Width</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minInclusive value="0.2" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Height</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:maxExclusive value="3.0" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCLABEL" cardinality="optional">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Reference</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="^W[0-9]+$" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Code</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:minLength value="3" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Mark</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:maxLength value="8" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Tag</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:length value="5" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>true</simpleValue>
                    </value>
                </property>
                <material uri="https://example.org/m" cardinality="prohibited">
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="Concrete" />
                            <xs:enumeration value="Steel" />
                        </xs:restriction>
                    </value>
                </material>
            </requirements>
        </specification>
        <specification name="Specification 2: IFCSLAB.FLOOR" ifcVersion="IFC4">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCSLAB</simpleValue>
                    </name>
                    <predefinedType>
                        <simpleValue>FLOOR</simpleValue>
                    </predefinedType>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="Specification 3: IFCWALL IFCSLAB" ifcVersion="IFC2X3" instructions="Phase: P1">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="IFCWALL" />
                            <xs:enumeration value="IFCSLAB" />
                        </xs:restriction>
                    </name>
                </entity>
                <property>
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                </property>
            </applicability>
            <requirements>
                <material cardinality="required">
                    <value>
                        <simpleValue>Concrete</simpleValue>
                    </value>
                </material>
            </requirements>
        </specification>
    </specifications>
</ids>